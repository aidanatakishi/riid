      "id": "overview",
      "title": "Ümumi panel KPI",
      "aliases": [
        "umumi veziyyet",
        "overview",
        "panel saylari",
        "kpi"
      ],
      "text": "Panel kartları cari filter (sprint, tarix, istiqamət, qurum) üzrə total, tamamlanan, açıq, gecikən, bloklanan, progress və tamamlanma faizini göstərir. AI Done eyni kəsiyə baxır."
    },
    {
      "id": "qurum",
      "title": "Qurum",
      "aliases": [
        "teskilat",
        "nazirlik",
        "agentlik",
        "xidmet",
        "org"
      ],
      "text": "Qurum — tapşırığa bağlanan dövlət qurumu (Nazirlik, Agentlik, Xidmət və s.). Qısa ad və ya rəsmi ad eyni qurumu bildirə bilər. Qurum üzrə iş yükü, gecikən və qiymətləndirmə balları alətlərlə oxunur."
    },
    {
      "id": "diag",
      "title": "Rəqəmsallaşma diaqnostikası",
      "aliases": [
        "diaqnostika",
        "diag",
        "reqemsal yetkinlik"
      ],
      "text": "Diaqnostika balı qurumlar üzrə reytingdir. «Ən yüksək/aşağı bal» üçün get_assessment_scores (category=diag) istifadə olunur."
    },
    {
      "id": "exq",
      "title": "Elektron xidmətlərin qiymətləndirilməsi",
      "aliases": [
        "exq",
        "elektron xidmet"
      ],
      "text": "EXQ balları qurum üzrədir; get_assessment_scores category=exq."
    },
    {
      "id": "isq",
      "title": "İnformasiya ehtiyat və sistemlərinin qiymətləndirilməsi",
      "aliases": [
        "isq",
        "informasiya ehtiyat"
      ],
      "text": "İSQ balları qurum üzrədir; get_assessment_scores category=isq."
    }
  ],
