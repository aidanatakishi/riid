APP_ENV=production
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
PORT=5000

JIRA_BASE_URL=https://jira.idda.az
JIRA_PROJECT_KEY=DGD
# İstehsalda yazın — istifadəçilər token yazmadan işləyər.
# JIRA_PAT=

# Uzun təsadüfi açar. Boşdursa data/secret.key yaranır.
SECRET_KEY=

# İlk admin yalnız data/users.json boş olanda .env-dən yaranır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=

# Şöbə istifadəçisi (istəyə bağlı).
# DEPT_USERNAME=qks
# DEPT_PASSWORD=
# DEPT_DISPLAY_NAME=Qiymətləndirmə və komplayens şöbəsi

# Netlify və ya başqa frontend varsa vergüllə:
# CORS_ORIGINS=https://riid.netlify.app

# HTTPS üçün reverse proxy arxasında TRUST_PROXY=true saxlayın.

# Chatbot açarı yalnız serverdədir — UI-də göstərilmir və brauzerdən göndərilmir.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
