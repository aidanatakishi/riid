JIRA_BASE_URL=https://jira.idda.az
JIRA_PROJECT_KEY=DGD
# İstehsalda JIRA_PAT yazın — istifadəçilər token yazmadan işləyər.
# JIRA_PAT=

# İlk admin (.env-dən avtomatik yaranır). Git-ə yazmayın.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Şöbə istifadəçisi (istəyə bağlı). Yoxdursa admin panelindən əlavə edin.
# DEPT_USERNAME=qks
# DEPT_PASSWORD=
# DEPT_DISPLAY_NAME=Qiymətləndirmə və komplayens şöbəsi

# İstehsalda HTTPS üçün:
# SESSION_COOKIE_SECURE=true
# Açarı buraya və ya Token panelindəki Chatbot sahəsinə yazın.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
