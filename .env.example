APP_ENV=production
FLASK_DEBUG=false
PORT=5000

# HTTPS reverse proxy (IIS/nginx) arxasında true.
# Daxili şəbəkədə http://IP:5000 ilə açırsınızsa false saxlayın — əks halda giriş cookie işləməz.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=true

JIRA_BASE_URL=https://jira.idda.az
JIRA_PROJECT_KEY=DGD
# Ümumi JIRA_PAT lazım deyil. Hər kəs öz tokenini girişdə bir dəfə yazır; data/secrets.json-da qalır.

# Uzun təsadüfi açar (məcburidir production üçün tövsiyə olunur).
# python -c "import secrets; print(secrets.token_hex(32))"
# Boşdursa data/secret.key yaranır.
SECRET_KEY=

# İlk admin yalnız data/users.json boş olanda .env-dən yaranır (ən azı 8 simvol).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=

# Şöbə istifadəçisi (istəyə bağlı).
# DEPT_USERNAME=qks
# DEPT_PASSWORD=
# DEPT_DISPLAY_NAME=Qiymətləndirmə və komplayens şöbəsi

# Əlavə frontend origin varsa vergüllə:
# CORS_ORIGINS=

# Chatbot açarı yalnız serverdədir — UI-də göstərilmir.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
